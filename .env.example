NODE_ENV=development
HOST=0.0.0.0
PORT=5000
PUBLIC_APP_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://infinitearcadia.com,https://www.infinitearcadia.com,https://blue-glacier-0c5743e10.7.azurestaticapps.net
UPLOAD_MAX_BYTES=26214400
ALLOW_ARCHIVE_UPLOADS=false

# PostgreSQL
POSTGRES_DB=credit_eoscar_flow
POSTGRES_USER=credit_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
DATABASE_URL=LOCAL_POSTGRES_CONNECTION_STRING
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret

# Production bootstrap/security
# Set this for first deployment, register these accounts, then remove after admin management is configured.
BOOTSTRAP_ADMIN_EMAILS=bgalloway17504@gmail.com,gravedigger137@icloud.com
SENSITIVE_CONFIG_ENCRYPTION_KEY=replace-with-32-byte-base64-or-utf8-secret
MALWARE_SCAN_PROVIDER=disabled
MALWARE_SCAN_COMMAND=
MALWARE_SCAN_TIMEOUT_MS=30000
PRIVATE_UPLOAD_STORAGE=local
SIGNED_DOWNLOAD_URLS_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=credit-application-files
# Optional; SESSION_SECRET is used when this is unset.
DOWNLOAD_URL_SIGNING_KEY=
MFA_ENFORCE_ADMIN=false
MFA_ISSUER=Credit-Eoscar
MFA_TOTP_WINDOW=1
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=120
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=

# Optional AI
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o
LOCAL_MODEL_ENDPOINT=

# Optional payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional banking
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional e-OSCAR / Metro 2 readiness
EOSCAR_API_BASE_URL=
EOSCAR_CLIENT_ID=
EOSCAR_CLIENT_SECRET=
EOSCAR_ENVIRONMENT=sandbox

# Optional institutional exchange engine
INSTITUTIONAL_EXCHANGE_WORKER_ENABLED=false
INSTITUTIONAL_EXCHANGE_WORKER_INTERVAL_MS=30000
INSTITUTIONAL_EXCHANGE_ALLOWED_ENDPOINTS=
INSTITUTIONAL_EXCHANGE_STRIPE_ENABLED=false
INSTITUTIONAL_EXCHANGE_STRIPE_ENDPOINT=
INSTITUTIONAL_EXCHANGE_STRIPE_CREDENTIAL_REF=
INSTITUTIONAL_EXCHANGE_DWOLLA_ENABLED=false
INSTITUTIONAL_EXCHANGE_DWOLLA_ENDPOINT=
INSTITUTIONAL_EXCHANGE_DWOLLA_CREDENTIAL_REF=
INSTITUTIONAL_EXCHANGE_ACH_ENABLED=false
INSTITUTIONAL_EXCHANGE_ACH_ENDPOINT=
INSTITUTIONAL_EXCHANGE_ACH_CREDENTIAL_REF=

# Optional Dwolla connector
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox
DWOLLA_API_URL=
DWOLLA_PLAID_EXCHANGE_PARTNER_HREF=
DWOLLA_WEBHOOK_SECRET=
DWOLLA_WEBHOOK_URL=http://localhost:5000/api/dwolla/webhooks
DWOLLA_DOCUMENT_UPLOADS_ENABLED=false
DWOLLA_DOCUMENT_MAX_BYTES=10485760
DWOLLA_PRIVATE_UPLOAD_DIR=private_uploads/dwolla-verification

# Optional OAuth. Configure redirect URLs as:
# ${PUBLIC_APP_URL}/api/v1/auth/google/callback
# ${PUBLIC_APP_URL}/api/v1/auth/facebook/callback
# ${PUBLIC_APP_URL}/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
