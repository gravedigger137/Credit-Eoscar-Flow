NODE_ENV=development
HOST=0.0.0.0
PORT=5000
PUBLIC_APP_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://infinitearcadia.com,https://www.infinitearcadia.com
UPLOAD_MAX_BYTES=104857600

# PostgreSQL
POSTGRES_DB=credit_eoscar_flow
POSTGRES_USER=credit_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://credit_app:credit_app_password@localhost:5432/credit_eoscar_flow
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret

# Optional AI
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o
LOCAL_MODEL_ENDPOINT=

# Optional payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional banking
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional OAuth. Configure redirect URLs as:
# ${PUBLIC_APP_URL}/api/v1/auth/google/callback
# ${PUBLIC_APP_URL}/api/v1/auth/facebook/callback
# ${PUBLIC_APP_URL}/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
