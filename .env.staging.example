NODE_ENV=production
HOST=0.0.0.0
PORT=5000
PUBLIC_APP_URL=https://staging-app.infinitearcadia.com
CORS_ALLOWED_ORIGINS=https://staging-app.infinitearcadia.com,https://staging.infinitearcadia.com
UPLOAD_MAX_BYTES=26214400
ALLOW_ARCHIVE_UPLOADS=false

# PostgreSQL staging database
DATABASE_URL=STAGING_POSTGRES_CONNECTION_STRING
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Sessions
SESSION_SECRET=REPLACE_WITH_STAGING_SECRET_FROM_SECRET_MANAGER

# Bootstrap/security
BOOTSTRAP_ADMIN_EMAILS=bgalloway17504@gmail.com,gravedigger137@icloud.com
SENSITIVE_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_STAGING_SECRET
MALWARE_SCAN_PROVIDER=disabled
MALWARE_SCAN_COMMAND=
MALWARE_SCAN_TIMEOUT_MS=30000
PRIVATE_UPLOAD_STORAGE=local
SIGNED_DOWNLOAD_URLS_ENABLED=false
MFA_ENFORCE_ADMIN=false
MFA_ISSUER=Credit-Eoscar
MFA_TOTP_WINDOW=1
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=120
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_REPORTING_DSN=

# AI staging
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=REPLACE_WITH_STAGING_OPENAI_KEY_OR_LEAVE_EMPTY
LOCAL_MODEL_ENDPOINT=

# Stripe test mode only
STRIPE_SECRET_KEY=STRIPE_TEST_SECRET_KEY_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=STRIPE_TEST_WEBHOOK_SECRET_PLACEHOLDER

# Plaid sandbox only
PLAID_CLIENT_ID=REPLACE_WITH_SANDBOX_CLIENT_ID
PLAID_SECRET=REPLACE_WITH_SANDBOX_SECRET
PLAID_ENV=sandbox

# e-OSCAR / Metro 2 readiness placeholders
EOSCAR_API_BASE_URL=
EOSCAR_CLIENT_ID=
EOSCAR_CLIENT_SECRET=
EOSCAR_ENVIRONMENT=sandbox

# OAuth staging callbacks
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=REPLACE_WITH_STAGING_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=REPLACE_WITH_STAGING_FACEBOOK_APP_SECRET
GITHUB_CLIENT_ID=REPLACE_WITH_STAGING_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_STAGING_GITHUB_CLIENT_SECRET
